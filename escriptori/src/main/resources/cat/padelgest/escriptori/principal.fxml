<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>


<BorderPane fx:id="arrel" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.PrincipalController">
   <top>
      <MenuBar>
         <menus>
            <Menu mnemonicParsing="false" text="Gestió">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#obrirPanell" text="Panell del dia" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#obrirPistes" text="Pistes" />
                  <MenuItem mnemonicParsing="false" onAction="#obrirUsuaris" text="Usuaris" />
                  <MenuItem mnemonicParsing="false" onAction="#obrirReserves" text="Reserves" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Recepció">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#obrirRecepcio" text="Verificar jugador" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Sessió">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#tancarSessio" text="Tancar sessió" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#sortir" text="Sortir" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
   </top>   
   <bottom>
      <HBox>
         <children>
            <Label fx:id="etiquetaUsuari" />
         </children>
         <padding>
            <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
