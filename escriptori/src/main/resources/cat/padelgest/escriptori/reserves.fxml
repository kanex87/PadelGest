<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.ReservesController">
   <children>
      <Label text="Reserves">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Dia" />
            <DatePicker fx:id="campData" />
            <Label text="Pista" />
            <ComboBox fx:id="campPista" prefWidth="150.0" />
         </children>
      </HBox>
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <TableView fx:id="taulaReserves" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="columnaHora" prefWidth="110.0" text="Hora" />
                        <TableColumn fx:id="columnaJugador" prefWidth="180.0" text="Jugador" />
                        <TableColumn fx:id="columnaEmail" prefWidth="200.0" text="Email" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                     <placeholder>
                        <Label text="No hi ha reserves per a aquest dia" />
                     </placeholder>
                  </TableView>
                  <Button mnemonicParsing="false" onAction="#cancelar" text="Cancel·lar reserva" />
               </children>
            </VBox>
            <VBox prefWidth="250.0" spacing="8.0">
               <children>
                  <Label text="Nova reserva">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  <Label text="Jugador" />
                  <ComboBox fx:id="campJugador" maxWidth="Infinity" promptText="Tria el jugador" />
                  <Label text="Franja lliure" />
                  <ComboBox fx:id="campFranja" maxWidth="Infinity" promptText="Tria l'hora" />
                  <Button defaultButton="true" mnemonicParsing="false" onAction="#reservar" text="Reservar" />
                  <Label fx:id="etiquetaMissatge" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
