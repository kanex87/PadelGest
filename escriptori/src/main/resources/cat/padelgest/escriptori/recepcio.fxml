<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.RecepcioController">
   <children>
      <Label text="Verificar jugador">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <TextField fx:id="campCerca" prefWidth="300.0" promptText="Nom, cognoms o email" />
            <Button defaultButton="true" mnemonicParsing="false" onAction="#cercar" text="Cercar" />
         </children>
      </HBox>
      <Label fx:id="etiquetaMissatge" />
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <ListView fx:id="llistaJugadors" prefWidth="320.0" />
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label fx:id="etiquetaJugador">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                  </Label>
                  <Label fx:id="etiquetaEstat" />
                  <Label text="Reserves d'avui" />
                  <TableView fx:id="taulaReserves" VBox.vgrow="ALWAYS">
                     <columns>
                        <TableColumn fx:id="columnaHora" prefWidth="110.0" text="Hora" />
                        <TableColumn fx:id="columnaPista" prefWidth="150.0" text="Pista" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                     </columnResizePolicy>
                     <placeholder>
                        <Label text="Cap reserva per a avui" />
                     </placeholder>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
