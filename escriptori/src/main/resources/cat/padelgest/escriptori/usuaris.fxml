<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.UsuarisController">
   <children>
      <Label text="Gestió d'usuaris">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="taulaUsuaris" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="columnaNom" prefWidth="170.0" text="Nom" />
                  <TableColumn fx:id="columnaEmail" prefWidth="190.0" text="Email" />
                  <TableColumn fx:id="columnaRol" prefWidth="70.0" text="Rol" />
                  <TableColumn fx:id="columnaEstat" prefWidth="90.0" text="Estat" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
            </TableView>
            <VBox prefWidth="250.0" spacing="8.0">
               <children>
                  <Label text="Nom" />
                  <TextField fx:id="campNom" />
                  <Label text="Cognoms" />
                  <TextField fx:id="campCognoms" />
                  <Label text="Email" />
                  <TextField fx:id="campEmail" />
                  <Label text="Rol" />
                  <ComboBox fx:id="campRol" maxWidth="Infinity" />
                  <Label text="Contrasenya inicial (només per a usuaris nous)" wrapText="true" />
                  <PasswordField fx:id="campContrasenya" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#nou" text="Nou" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#desar" text="Desar" />
                        <Button fx:id="botoEstat" mnemonicParsing="false" onAction="#canviarEstat" text="Desactivar" />
                     </children>
                  </HBox>
                  <Button fx:id="botoContrasenya" maxWidth="Infinity" mnemonicParsing="false" onAction="#restablirContrasenya" text="Restablir contrasenya" />
                  <Label fx:id="etiquetaMissatge" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
