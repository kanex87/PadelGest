<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.PistesController">
   <children>
      <Label text="Gestió de pistes">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <HBox spacing="20.0" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="taulaPistes" HBox.hgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="columnaNom" prefWidth="220.0" text="Nom" />
                  <TableColumn fx:id="columnaTipus" prefWidth="140.0" text="Tipus" />
                  <TableColumn fx:id="columnaEstat" prefWidth="140.0" text="Estat" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
               </columnResizePolicy>
            </TableView>
            <VBox prefWidth="250.0" spacing="10.0">
               <children>
                  <Label text="Nom" />
                  <TextField fx:id="campNom" promptText="Per exemple: Pista 5" />
                  <Label text="Tipus" />
                  <ComboBox fx:id="campTipus" maxWidth="Infinity" promptText="Tria el tipus" />
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#nova" text="Nova" />
                        <Button defaultButton="true" mnemonicParsing="false" onAction="#desar" text="Desar" />
                        <Button fx:id="botoEstat" disable="true" mnemonicParsing="false" onAction="#canviarEstat" text="Desactivar" />
                     </children>
                  </HBox>
                  <Label fx:id="etiquetaMissatge" wrapText="true" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
