<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefWidth="360.0" spacing="10.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cat.padelgest.escriptori.controller.LoginController">
   <children>
      <Label text="PadelGest">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Administració del club" />
      <TextField fx:id="campEmail" promptText="Email" />
      <PasswordField fx:id="campContrasenya" promptText="Contrasenya" />
            <Button fx:id="botoEntrar" defaultButton="true" maxWidth="Infinity" mnemonicParsing="false" onAction="#entrar" text="Entrar" />
      <Label fx:id="etiquetaMissatge" wrapText="true" />
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>